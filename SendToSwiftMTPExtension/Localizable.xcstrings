{
  "sourceLanguage": "en",
  "strings": {
    "No files found.": {
      "comment": "Shown when the shared selection contains no files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No files found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron archivos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが見つかりません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы не найдены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到檔案。"
          }
        }
      }
    },
    "Opening SwiftMTP…": {
      "comment": "Status shown while the share extension opens the containing app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening SwiftMTP…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abriendo SwiftMTP…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftMTP を開いています…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытие SwiftMTP…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开 SwiftMTP…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在開啟 SwiftMTP…"
          }
        }
      }
    },
    "The selection contains an unsupported item.": {
      "comment": "Error when an attachment cannot provide a file URL.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selection contains an unsupported item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección contiene un elemento no compatible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択項目に対応していない項目が含まれています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среди выбранных объектов есть неподдерживаемый объект."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选内容包含不受支持的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選內容包含不支援的項目。"
          }
        }
      }
    },
    "The selection does not contain a file URL.": {
      "comment": "Error when an attachment does not return a local file URL.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selection does not contain a file URL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección no contiene una URL de archivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択項目にファイルの URL が含まれていません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные объекты не содержат URL-адрес файла."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选内容未包含文件 URL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
